# Google Cloud / Earth Engine Configuration
GEE_PROJECT_ID=flashflood-508519
GEE_SERVICE_ACCOUNT_KEY=

# Default Region: indonesia, west_java, dki_jakarta, north_sumatra, bali
DEFAULT_REGION=west_java

# Alert Thresholds
# Critical 24-hour rainfall in mm
CRITICAL_RAINFALL_MM=50.0
# Static susceptibility risk index threshold (0-100 scale)
SUSCEPTIBILITY_ALERT_THRESHOLD=70.0
# Antecedent precipitation (3-day soil saturation) threshold in mm
ANTECEDENT_RAINFALL_THRESHOLD=100.0
# Minimum cluster area for vectorization in hectares (to filter single-pixel noise)
MIN_CLUSTER_AREA_HA=25.0

# Notification Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
